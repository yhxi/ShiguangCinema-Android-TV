<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 后台播放时显示常驻通知（Android 13+ 需要用户授权，拒绝也不影响播放） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 内置文件浏览器用：电视/投影仪常常没有 DocumentsUI，无法调系统文件选择器 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- 声明为「非必需」：个别电视 ROM 的特性表不全，若标成必需会被判设备不兼容、装不上 -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/cloudscreen_banner"
        android:icon="@drawable/app_icon_clock"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme" />

        <!-- 网络诊断：不进桌面，只能从「设置 → 网络诊断」进 -->
        <activity
            android:name=".NetDiagActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:theme="@style/AppTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台播放通知上的暂停/停止按钮：只在应用内用，不导出 -->
        <receiver
            android:name=".PlaybackReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lshai.cloudscreen.PLAYBACK_TOGGLE" />
                <action android:name="com.lshai.cloudscreen.PLAYBACK_STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
